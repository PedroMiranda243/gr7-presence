root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{bat,cmd,ps1,txt}]
end_of_line = crlf

# O PowerShell 5.1 (o do Windows) lê arquivo sem BOM como ANSI e estraga os acentos das mensagens.
[*.ps1]
charset = utf-8-bom

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
